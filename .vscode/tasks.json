{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++",
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",
				"-std=c++23",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/build/${fileBasenameNoExtension}",
				"-g3"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: /usr/bin/g++",
			"dependsOn": "Clean binary"
		},
		{
			"type": "cppbuild",
			"label": "C/C++: arm",
			"command": "arm-linux-gnueabihf-g++-14",
			"args": [
				"-fdiagnostics-color=always",
				"-std=c++23",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/build/${fileBasenameNoExtension}_armv7",
				"-g3"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: /usr/bin/g++",
		},
		{
			"label": "Clean binary",
			"type": "shell",
			"command": "rm",
			"args": [
				"-rf",
				"${fileDirname}/build/*"
			],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": false
			}
		},
		{
			"type": "shell",
			"label": "run program",
			"command": "${fileDirname}/build/${fileBasenameNoExtension}",
			"dependsOn": "C/C++: g++",
			"problemMatcher": []
		}
	]
}